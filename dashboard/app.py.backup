    if st.button("Save appearance",use_container_width=True):
        for k,v in {"theme":theme,"panel":panel,"border":border,"text":textc,"accent":accent,"invert":"1" if invert else "0"}.items():set_setting(k,v)
if invert:panel,textc=textc,panel
st.markdown(f"<style>:root{{--cyan:{accent}!important}} .stApp{{background:{bg}!important;color:{textc}}} [data-testid='stMainBlockContainer']{{max-width:1840px!important;padding-left:1.6rem!important;padding-right:1.6rem!important}} [data-testid='stVerticalBlockBorderWrapper']{{background:{panel}!important;border:2px solid {border}!important;border-radius:2px!important;padding:.3rem}}</style>", unsafe_allow_html=True)
